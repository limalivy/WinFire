<?xml version="1.0" encoding="utf-8"?>
<!-- 微火输入法 配置界面（纯 Win32）EXE 工程。需在 Windows + VS2022 中构建。 -->
<Project DefaultTargets="Build" ToolsVersion="17.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{F1RE0002-0000-0000-0000-0000000CFG01}</ProjectGuid>
    <RootNamespace>fire_config</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <!-- 使用默认 PlatformToolset，兼容 VS 2022/2026+ -->
    <PlatformToolset>$(DefaultPlatformToolset)</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ItemDefinitionGroup>
    <ClCompile>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <AdditionalIncludeDirectories>$(ProjectDir)..\..\core\include;$(ProjectDir)..\..\ipc\include;$(ProjectDir)..\..\third_party\sqlite3;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>WIN32;_WINDOWS;UNICODE;_UNICODE;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions>
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <AdditionalDependencies>shell32.lib;advapi32.lib;user32.lib;comctl32.lib;comdlg32.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
    <ResourceCompile>
      <PreprocessorDefinitions>__cplusplus;_M_X64;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ResourceCompile>
  </ItemDefinitionGroup>
  <!-- Release 配置：开启优化与死代码消除。
       基础 ItemDefinitionGroup 无 Condition（Debug/Release 共用），MSBuild 默认 /Od（禁用优化），
       导致 Debug/Release 二进制体积几乎相同。本块仅对 Release 追加标准优化项，
       不覆盖基础块的 RuntimeLibrary/LanguageStandard/AdditionalDependencies 等设置。
         Optimization=MaxSpeed (/O2)        速度优先优化
         FavorSizeOrSpeed=Size (/Os)        sqlite 等大块未用代码优先折叠缩小体积
         OmitFramePointers=true             省栈帧指针
         WholeProgramOptimization=true      LTCG，跨编译单元内联+死代码消除
         StringPooling=true                 只读字符串合并
         FunctionLevelLinking=true (/Gy)    函数级链接，配合链接器 /OPT:REF 消除未引用函数
         DebugInformationFormat=ProgramDatabase  仍生成 PDB 便于排障，但不内嵌进 EXE
       链接器：LinkTimeCodeGeneration 启用整程序优化；
                OptimizeReferences=true (/OPT:REF) 删除未引用 COMDAT；
                EnableCOMDATFolding=true (/OPT:ICF) 合并等价 COMDAT。 -->
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release'">
    <ClCompile>
      <Optimization>MaxSpeed</Optimization>
      <FavorSizeOrSpeed>Size</FavorSizeOrSpeed>
      <OmitFramePointers>true</OmitFramePointers>
      <WholeProgramOptimization>true</WholeProgramOptimization>
      <StringPooling>true</StringPooling>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <DebugInformationFormat>ProgramDatabase</DebugInformationFormat>
    </ClCompile>
    <Link>
      <LinkTimeCodeGeneration>UseLinkTimeCodeGeneration</LinkTimeCodeGeneration>
      <OptimizeReferences>true</OptimizeReferences>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="ConfigApp.cpp" />
    <ClCompile Include="InputSettingsPage.cpp" />
    <ClCompile Include="PunctuationPage.cpp" />
    <ClCompile Include="AppModePage.cpp" />
    <ClCompile Include="StatisticsPage.cpp" />
    <ClCompile Include="DictPage.cpp" />
    <!-- 跨平台内核：统计功能所需 -->
    <ClCompile Include="..\..\core\src\statistics.cpp" />
    <ClCompile Include="..\..\core\src\input_mode_cache.cpp" />
    <ClCompile Include="..\..\core\src\candidate.cpp" />
    <ClCompile Include="..\..\core\src\types.cpp" />
    <ClCompile Include="..\..\core\src\utf8.cpp" />
    <ClCompile Include="ConfigStore.cpp" />
    <!-- config 收敛到 dictd：经 IPC 获取/更新 config（config.exe 不再直接读写 config.json） -->
    <ClCompile Include="ConfigIpcClient.cpp" />
    <ClCompile Include="..\..\ipc\src\wire.cpp" />
    <ClCompile Include="..\..\ipc\src\protocol.cpp" />
    <!-- 第三方源码 -->
    <!-- 编译项目 wrapper（先注入 fire_sqlite_compile_options.h 裁剪宏，再编译 sqlite3.c），而非官方 sqlite3.c -->
    <ClCompile Include="..\..\third_party\sqlite3\fire_sqlite3_amalg.c" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="UiBase.h" />
    <ClInclude Include="ConfigApp.h" />
    <ClInclude Include="InputSettingsPage.h" />
    <ClInclude Include="PunctuationPage.h" />
    <ClInclude Include="AppModePage.h" />
    <ClInclude Include="StatisticsPage.h" />
    <ClInclude Include="DictPage.h" />
    <ClInclude Include="ConfigStore.h" />
    <ClInclude Include="ConfigIpcClient.h" />
  </ItemGroup>
  <ItemGroup>
    <ResourceCompile Include="ConfigApp.rc" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
