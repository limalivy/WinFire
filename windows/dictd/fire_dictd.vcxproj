<?xml version="1.0" encoding="utf-8"?>
<!-- 微火输入法 后台查字进程（fire_dictd.exe）Windows GUI EXE 工程（常驻，经 HKCU/HKLM\Run 自启，不弹控制台）。需在 Windows + VS2022 中构建。 -->
<Project DefaultTargets="Build" ToolsVersion="17.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{F1RE0003-0000-0000-0000-000000DICTD1}</ProjectGuid>
    <RootNamespace>fire_dictd</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <!-- 使用默认 PlatformToolset，兼容 VS 2022/2026+ -->
    <PlatformToolset>$(DefaultPlatformToolset)</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ItemDefinitionGroup>
    <ClCompile>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <AdditionalIncludeDirectories>$(ProjectDir)..\..\core\include;$(ProjectDir)..\..\ipc\include;$(ProjectDir)..\config;$(ProjectDir)..\..\third_party\sqlite3;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>WIN32;_WINDOWS;UNICODE;_UNICODE;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions>
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <AdditionalDependencies>shell32.lib;advapi32.lib;user32.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
    <ClCompile>
      <PreprocessorDefinitions>FIRE_DEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
  <!-- Release 配置：开启优化与死代码消除（说明同 fire_config.vcxproj）。
       基础 ItemDefinitionGroup 无 Condition，MSBuild 默认 /Od，需在此为 Release 显式开启。 -->
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release'">
    <ClCompile>
      <Optimization>MaxSpeed</Optimization>
      <FavorSizeOrSpeed>Size</FavorSizeOrSpeed>
      <OmitFramePointers>true</OmitFramePointers>
      <WholeProgramOptimization>true</WholeProgramOptimization>
      <StringPooling>true</StringPooling>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <DebugInformationFormat>ProgramDatabase</DebugInformationFormat>
    </ClCompile>
    <Link>
      <LinkTimeCodeGeneration>UseLinkTimeCodeGeneration</LinkTimeCodeGeneration>
      <OptimizeReferences>true</OptimizeReferences>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <!-- 后台进程实现 -->
    <ClCompile Include="main.cpp" />
    <ClCompile Include="NamedPipeServer.cpp" />
    <ClCompile Include="DictServer.cpp" />
    <!-- 配置读取（复用 fire_config 的 ConfigStore） -->
    <ClCompile Include="..\config\ConfigStore.cpp" />
    <!-- IPC 协议编解码 -->
    <ClCompile Include="..\..\ipc\src\wire.cpp" />
    <ClCompile Include="..\..\ipc\src\protocol.cpp" />
    <!-- 跨平台内核：真正碰 SQLite 的查字/统计逻辑 -->
    <ClCompile Include="..\..\core\src\types.cpp" />
    <ClCompile Include="..\..\core\src\candidate.cpp" />
    <ClCompile Include="..\..\core\src\punctuation.cpp" />
    <ClCompile Include="..\..\core\src\dict_manager.cpp" />
    <ClCompile Include="..\..\core\src\query_cache_store.cpp" />
    <ClCompile Include="..\..\core\src\input_mode_cache.cpp" />
    <ClCompile Include="..\..\core\src\statistics.cpp" />
    <ClCompile Include="..\..\core\src\utf8.cpp" />
    <!-- 第三方源码 -->
    <ClCompile Include="..\..\third_party\sqlite3\sqlite3.c" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="NamedPipeServer.h" />
    <ClInclude Include="DictServer.h" />
    <ClInclude Include="DictLog.h" />
    <ClInclude Include="..\common\IpcShared.h" />
    <ClInclude Include="..\config\ConfigStore.h" />
  </ItemGroup>
  <!-- ===================================================================== -->
  <!-- 版本号单一来源：从仓库根目录的 VERSION 文件生成 Version.h（与 fire_tsf 一致）。 -->
  <!-- VERSION 不纳入 git；缺失时回退到已跟踪的基线 VERSION.default。 -->
  <!-- ===================================================================== -->
  <Target Name="GenerateVersionHeader" BeforeTargets="ClCompile">
    <PropertyGroup>
      <VersionFilePath Condition="Exists('$(ProjectDir)..\..\VERSION')">$(ProjectDir)..\..\VERSION</VersionFilePath>
      <VersionFilePath Condition="'$(VersionFilePath)'==''">$(ProjectDir)..\..\VERSION.default</VersionFilePath>
    </PropertyGroup>
    <Error Condition="!Exists('$(VersionFilePath)')" Text="Neither VERSION nor VERSION.default found under repo root" />
    <ReadLinesFromFile File="$(VersionFilePath)">
      <Output TaskParameter="Lines" ItemName="VersionLines" />
    </ReadLinesFromFile>
    <PropertyGroup>
      <FireVersion>$([System.String]::Copy('%(VersionLines.Identity)').Trim())</FireVersion>
      <FireVerMajor>$(FireVersion.Split('.')[0])</FireVerMajor>
      <FireVerMinor>$(FireVersion.Split('.')[1])</FireVerMinor>
      <FireVerPatch>$(FireVersion.Split('.')[2])</FireVerPatch>
      <VersionHeaderContent>// 自动生成，请勿手改；版本号单一来源为仓库根目录 VERSION 文件。%0D%0A#pragma once%0D%0A#define FIRE_VER_MAJOR $(FireVerMajor)%0D%0A#define FIRE_VER_MINOR $(FireVerMinor)%0D%0A#define FIRE_VER_PATCH $(FireVerPatch)%0D%0A#define FIRE_VER_STRING "$(FireVersion)"%0D%0A</VersionHeaderContent>
    </PropertyGroup>
    <WriteLinesToFile File="$(ProjectDir)Version.h" Lines="$(VersionHeaderContent)" Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
